rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. PELO DATA COLLECTION
    match /users/{userId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
    match /collectors/{collectorId} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.uid == collectorId; }
    match /entries/{entryId} { allow read: if request.auth != null; allow create: if request.auth != null; allow update: if request.auth != null && request.auth.uid == resource.data.userId; }
    match /quantum_audits/{auditId} { allow read: if request.auth != null; allow write: if false; }
    match /payment_audits/{auditId} { allow read: if request.auth != null; allow write: if false; }
    match /carbon_credits/{creditId} { allow read: if request.auth != null; allow write: if false; }

    // 2. SALARYPLAN
    match /salary_users/{userId} { allow read, write: if request.auth != null && request.auth.uid == userId; }
    match /salary_plans/{planId} { allow read, write: if request.auth != null && request.auth.uid == resource.data.userId; allow create: if request.auth != null; }
    match /salary_audits/{auditId} { allow read: if request.auth != null; allow write: if false; }

    // 3. LUVUNO QUANTUM OS
    match /luvuno_sessions/{sessionId} { allow read, update: if request.auth != null && request.auth.uid == resource.data.userId; allow create: if request.auth != null; }
    match /luvuno_audits/{auditId} { allow read: if request.auth != null; allow write: if false; }

  }
}
