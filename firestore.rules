rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // CORE IDENTITY
    // ============================================================
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // 1. PELO — COMMUNITY SAFETY + WASTE MANAGEMENT
    // ============================================================
    match /collectors/{collectorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == collectorId;
    }
    match /entries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    match /quantum_audits/{auditId} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions only
    }
    match /payment_audits/{auditId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /carbon_credits/{creditId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /quantum_state/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Cloud Functions only
    }

    // ============================================================
    // 2. SALARYPLAN — FINANCIAL INTELLIGENCE
    // ============================================================
    match /salary_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /salary_plans/{planId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
    match /salary_audits/{auditId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /debts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /borrows/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /lends/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // 3. LUVUNO QUANTUM OS
    // ============================================================
    match /luvuno_sessions/{sessionId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
    }
    match /luvuno_audits/{auditId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ============================================================
    // 4. KHENSANI AI — EDUCATION STACK
    // ============================================================
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.teacherUid;
      allow create: if request.auth != null;
      match /students/{studentId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
    match /teacher_videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.teacherUid;
      allow create: if request.auth != null;
    }
    match /teacher_work/{workId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.teacherUid;
      allow create: if request.auth != null;
    }
    match /teacher_documents/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.teacherUid;
      allow create: if request.auth != null;
    }
    match /teacher_student_links/{linkId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /student_videos/{videoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.studentUid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
    }

    // ============================================================
    // 5. WASTE ENGINE + INDUSTRIAL PORTAL
    // ============================================================
    match /pelo_master_ledger/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    match /drivers/{driverId} {
      allow read, write: if request.auth != null && request.auth.uid == driverId;
      allow create: if request.auth != null;
    }
    match /suppliers/{supplierId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // ============================================================
    // 6. TENSORA / MOLECULEMIND — DRUG DISCOVERY
    // ============================================================
    match /moleculemind/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /quantum_predictions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ============================================================
    // 7. BLACKSKY QPAY + QMAPS
    // ============================================================
    match /transactions/{txnId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false; // Immutable after creation
    }
    match /qmaps_locations/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ============================================================
    // 8. CATCH-ALL (LAST RESORT)
    // ============================================================
    // If a collection is not explicitly listed above,
    // authenticated users can read and write.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
